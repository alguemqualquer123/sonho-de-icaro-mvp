# Copie para .env.local e preencha com os valores reais.
# NUNCA commite o .env.local: este arquivo é só o formato, sem segredos.

# Pasta dos comprovantes locais e uploads (padrão: ./data)
DATA_DIR=./data

# Segredo que assina as sessões. Troque em produção.
SESSION_SECRET=dev-secret-troque-em-producao

# Validade da sessão em horas (padrão: 12)
SESSION_TTL_HORAS=12

# --- Supabase / Postgres (valores no painel do Supabase) ---
# O app lê, nesta ordem: DATABASE_URL, SUPABASE_DB_URL,
# POSTGRES_URL_NON_POOLING, POSTGRES_URL, POSTGRES_PRISMA_URL.
DATABASE_URL="postgresql://postgres.sua-ref:sua-senha@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
SUPABASE_DB_URL=""
POSTGRES_URL_NON_POOLING="postgresql://postgres.sua-ref:sua-senha@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
POSTGRES_URL="postgresql://postgres.sua-ref:sua-senha@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://postgres.sua-ref:sua-senha@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="sua-senha"
POSTGRES_DATABASE="postgres"
POSTGRES_HOST="db.sua-ref.supabase.co"
SUPABASE_URL="https://sua-ref.supabase.co"

# --- Chaves públicas do Supabase (podem ir no client) ---
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sua-publishable-key"

# --- Segredos (somente servidor; nunca no client nem no git) ---
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"
SUPABASE_SECRET_KEY="sua-secret-key"
SUPABASE_JWT_SECRET="seu-jwt-secret"

# --- CDN dos comprovantes (fotos). Sem a chave, fotos caem no disco local;
# PDF sempre fica em disco. Obtenha em https://fivemanage.com
FIVEMANAGE_API_KEY=""
