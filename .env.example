# Copie para .env.local. Nada aqui é obrigatório no dev: os valores abaixo
# já são os padrões usados quando a variável não existe.

# Pasta do banco SQLite e dos comprovantes (padrão: ./data)
DATA_DIR=./data

# Segredo que assina o hash das sessões. Troque em produção: sem ele,
# qualquer pessoa que leia o código pode reproduzir os tokens.
SESSION_SECRET=dev-secret-troque-em-producao

# Validade da sessão em horas (padrão: 12)
SESSION_TTL_HORAS=12
